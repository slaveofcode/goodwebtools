---
import { ViewTransitions } from 'astro:transitions';
import { ShellIsland } from '@/components/shell/ShellIsland';
import { GlobalHotkeyInit } from '@/components/shell/GlobalHotkeyInit';
import { ConsentRibbon } from '@/components/shell/ConsentRibbon';
import { SITE_NAME, SITE_TAGLINE, SITE_URL, GA_ID, NOINDEX } from '@/config';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  /** OG/Twitter image path (absolute or site-relative). */
  image?: string;
  /** Override the canonical URL (defaults to the current path on SITE_URL). */
  canonical?: string;
  /** Set for pages that should not be indexed (e.g. 404). */
  noindex?: boolean;
  /** Replace the "<title> | GoodWebTools" pattern entirely. */
  fullTitle?: string;
  /** JSON-LD structured data object(s) to embed. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE_TAGLINE,
  keywords,
  image = '/og.png',
  canonical,
  noindex = false,
  fullTitle,
  jsonLd,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, SITE_URL).href;
const pageTitle = fullTitle ?? `${title} | ${SITE_NAME}`;
const ogImage = new URL(image, SITE_URL).href;

// Site-wide structured data + any page-specific graph.
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_TAGLINE,
};
const jsonLdBlocks = [siteJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex || NOINDEX ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Self-hosted display font (same-origin, preloaded to avoid FOUT) -->
    <link
      rel="preload"
      href="/fonts/space-grotesk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#fffdf5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Structured data -->
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <ViewTransitions />
    <script is:inline>
      // Apply environment classes before paint — on initial load AND after every
      // View Transitions navigation (otherwise the class is lost when the incoming
      // static page swaps in). `dark` = saved theme; `tauri` = running in the
      // desktop app (reveals desktop-only tools that are hidden on the web).
      var __isTauri = '__TAURI__' in window && window.__TAURI__ !== undefined;
      function applyEnvClasses() {
        var root = document.documentElement;
        root.classList.toggle('dark', localStorage.getItem('theme') === 'dark');
        root.classList.toggle('tauri', __isTauri);
      }
      applyEnvClasses();
      document.addEventListener('astro:after-swap', applyEnvClasses);
    </script>

    <!-- Google Analytics (GDPR): loads only when configured AND consent granted. -->
    <script is:inline define:vars={{ gaId: GA_ID }}>
      (function () {
        if (!gaId) return;
        function loadGA() {
          if (window.__gaLoaded) return;
          window.__gaLoaded = true;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', gaId, { anonymize_ip: true });
        }
        if (localStorage.getItem('gwt-consent') === 'granted') loadGA();
        window.addEventListener('gwt:consent', function (e) {
          if (e.detail === 'granted') loadGA();
        });
        document.addEventListener('astro:page-load', function () {
          if (window.gtag) window.gtag('event', 'page_view', {
            page_path: location.pathname + location.search,
            page_location: location.href,
          });
        });
      })();
    </script>
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <GlobalHotkeyInit client:load transition:persist />
    <ShellIsland client:load transition:persist />
    <slot />
    <ConsentRibbon client:idle transition:persist />
  </body>
</html>
