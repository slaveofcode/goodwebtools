---
import Base from '@/layouts/Base.astro';
import { ToolGrid } from '@/components/ToolGrid';
import ShareButton from '@/islands/share/ShareButton';
import { tools } from '@/registry/tools';
import { SITE_URL, SITE_NAME, SITE_TAGLINE } from '@/config';
import { LOCALES, localeParam, localizePath, type Lang } from '@/i18n/config';
import { t } from '@/i18n/ui';

export function getStaticPaths() {
  return LOCALES.map(lang => ({ params: { locale: localeParam(lang) }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const homeTitle = t(lang, 'home.title');
const homeDescription = t(lang, 'home.metaDescription', { n: tools.length });
const homeUrl = new URL(localizePath('/', lang), SITE_URL).href;
const shareUrl = lang === 'en' ? SITE_URL : homeUrl;
const homeKeywords = [
  'online tools', 'free tools', 'browser tools', 'privacy tools', 'no upload',
  'pdf tools', 'image tools', 'developer tools', 'json formatter', 'convert', 'client-side',
];

// ItemList of every tool helps search engines discover the full catalog.
const toolList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'GoodWebTools catalog',
  numberOfItems: tools.length,
  itemListElement: tools.map((tool, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: tool.name,
    description: tool.summary,
    url: new URL(localizePath(tool.route, lang), SITE_URL).href,
  })),
};
---

<Base
  title="Home"
  fullTitle={homeTitle}
  description={homeDescription}
  keywords={homeKeywords}
  canonical={homeUrl}
  jsonLd={toolList}
  lang={lang}
  localized
>
  <main class="page-container py-10">
    <header class="mb-10">
      {/* Brand lives in the top navbar; keep an accessible heading without duplicating it. */}
      <h1 class="sr-only">GoodWebTools</h1>
      <p class="max-w-2xl text-lg font-medium text-foreground">
        {t(lang, 'home.lead', { n: tools.length })}
      </p>
      <button
        id="home-search"
        type="button"
        class="mt-3 inline-flex items-center gap-1.5 border-2 border-border bg-muted px-3 py-1.5 text-sm font-bold uppercase tracking-wide text-muted-foreground shadow-brutal-sm press-brutal"
      >
        <span set:html={t(lang, 'home.searchHint', { kbd: '<kbd class="border-2 border-border bg-background px-1.5 py-0.5 font-mono text-xs">⌘K</kbd>' })} />
      </button>
      <div class="mt-4">
        <ShareButton client:idle url={shareUrl} title={SITE_NAME} text={SITE_TAGLINE} />
      </div>
    </header>

    <ToolGrid lang={lang} />
  </main>

  <script>
    // Let non-keyboard users open the command palette by clicking the hint.
    document.getElementById('home-search')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('gwt:open-search'));
    });
  </script>
</Base>
