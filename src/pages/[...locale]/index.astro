---
import Base from '@/layouts/Base.astro';
import { ToolGrid } from '@/components/ToolGrid';
import MobileCategoryNav from '@/islands/home/MobileCategoryNav';
import ShareButton from '@/islands/share/ShareButton';
import { tools } from '@/registry/tools';
import { localizedTool } from '@/registry/tool-i18n';
import { SITE_URL, SITE_NAME, SITE_TAGLINE } from '@/config';
import { LOCALES, localeParam, localizePath, type Lang } from '@/i18n/config';
import { t } from '@/i18n/ui';

export function getStaticPaths() {
  return LOCALES.map(lang => ({ params: { locale: localeParam(lang) }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const homeTitle = t(lang, 'home.title');
const homeDescription = t(lang, 'home.metaDescription', { n: tools.length });
const homeUrl = new URL(localizePath('/', lang), SITE_URL).href;
const shareUrl = lang === 'en' ? SITE_URL : homeUrl;
const homeKeywords = [
  'online tools', 'free tools', 'browser tools', 'privacy tools', 'no upload',
  'pdf tools', 'image tools', 'developer tools', 'json formatter', 'convert', 'client-side',
];

// ItemList of every tool helps search engines discover the full catalog.
const toolList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: lang === 'id' ? 'Katalog GoodWebTools' : 'GoodWebTools catalog',
  numberOfItems: tools.length,
  itemListElement: tools.map((tool, i) => {
    const label = localizedTool(tool, lang);
    return {
      '@type': 'ListItem',
      position: i + 1,
      name: label.name,
      description: label.summary,
      url: new URL(localizePath(tool.route, lang), SITE_URL).href,
    };
  }),
};
---

<Base
  title="Home"
  fullTitle={homeTitle}
  description={homeDescription}
  keywords={homeKeywords}
  canonical={homeUrl}
  jsonLd={toolList}
  lang={lang}
  localized
>
  <main class="page-container py-10">
    <header class="mb-10">
      {/* Brand lives in the top navbar; keep an accessible heading without duplicating it. */}
      <h1 class="sr-only">GoodWebTools</h1>
      <p class="max-w-2xl text-lg font-medium text-foreground">
        {t(lang, 'home.lead', { n: tools.length })}
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button
          id="home-search"
          type="button"
          class="inline-flex items-center gap-1.5 border-2 border-border bg-muted px-3 py-1.5 text-sm font-bold uppercase tracking-wide text-muted-foreground shadow-brutal-sm press-brutal"
        >
          <span set:html={t(lang, 'home.searchHint', { kbd: '<kbd class="border-2 border-border bg-background px-1.5 py-0.5 font-mono text-xs">⌘K</kbd>' })} />
        </button>
        <button
          id="home-agent"
          type="button"
          class="inline-flex items-center gap-1.5 border-2 border-border bg-accent px-3 py-1.5 text-sm font-bold uppercase tracking-wide text-accent-foreground shadow-brutal-sm press-brutal"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
          {lang === 'id' ? 'Tanya agen' : 'Ask agent'}
        </button>
      </div>
      <div class="mt-4">
        <ShareButton client:idle url={shareUrl} title={SITE_NAME} text={SITE_TAGLINE} />
      </div>
    </header>

    <ToolGrid lang={lang} />
    <MobileCategoryNav client:idle lang={lang} />
  </main>
</Base>
