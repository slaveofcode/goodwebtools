---
import { ChevronRight } from 'lucide-react';
import Base from '@/layouts/Base.astro';
import { REPO_URL } from '@/config';
import { LOCALES, localeParam, localizePath, type Lang } from '@/i18n/config';

export function getStaticPaths() {
  return LOCALES.map(lang => ({ params: { locale: localeParam(lang) }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const homePath = localizePath('/', lang);

const P = {
  en: {
    title: 'Privacy', home: 'Home', crumb: 'Privacy',
    metaDesc: 'How GoodWebTools protects your privacy: files never leave your browser, analytics only load with your consent, and how Google ads on the site use cookies.',
    h1: 'Privacy & Verifiability',
    s1H: 'No data leaves your device',
    s1P: 'All processing happens in your browser. No files, images, or documents are ever uploaded to a server.',
    s2H: 'Analytics & cookies',
    s2Pa: 'We use a single privacy-friendly analytics cookie (Google Analytics, with IP anonymization) to understand which tools people find useful. It ',
    s2Strong: 'only loads after you click “Accept”',
    s2Pb: ' in the cookie banner — decline and no analytics cookie is set. This never includes your files or their contents; your documents are always processed entirely on your device.',
    s2P2: "You can change your mind anytime by clearing this site's data in your browser settings, which resets the banner.",
    adsH: 'Advertising',
    adsP: [
      'GoodWebTools is free and funded by ads served by Google AdSense. Ads appear on the website only — never inside your files, and never in the browser extension or the results of a tool.',
      'Third-party vendors, including Google, use cookies to serve ads based on your previous visits to this website and other websites. Google’s advertising cookies let Google and its partners show you ads based on those visits.',
      'In the European Economic Area, the UK and Switzerland, you are asked for consent before personalised ads or advertising cookies are used. If you decline, Google may still show non-personalised ads, which use cookies only for things like frequency capping and fraud prevention.',
      'We also use Google Ads measurement to see how many visitors arrive from our own ads.',
      'Ad scripts never receive your files, text or tool results — those are processed on your device and are not sent anywhere.',
    ],
    adsOptOut: 'Opt out of personalised advertising in',
    adsOptOutGoogle: 'Google’s My Ad Center',
    adsOptOutOr: ', or opt out of other vendors’ personalised ads at',
    adsHow: 'Learn',
    adsHowLink: 'how Google uses information from sites that use its services',
    s3H: 'Verify it yourself',
    s3: ['Open Developer Tools (F12)', 'Go to the Network tab', 'Use any tool and process a file', 'Watch: your file is never sent — the only external requests are the page’s own ads and analytics, which never contain it'],
    s4H: 'Works offline',
    s4P: 'After first use, tools work with your network completely off. This is the strongest proof that nothing leaves your device.',
    s5H: 'Open source',
    s5Pa: 'The code is open source on GitHub — you can audit it yourself or run it locally: ',
    s6H: 'Browser extension (GoodWebTools Companion)',
    s6P: 'The optional Chrome extension follows the same rule: your data stays on your device.',
    s6: [
      'It only acts when you use it — a right-click action, a popup button, the side panel, a recording or a hotkey. It does not read pages in the background or collect your browsing history.',
      'An image, text or URL you send to a tool goes from the extension straight to the GoodWebTools tab it opens, inside your browser. It is kept for at most 5 minutes and used once.',
      'Recordings and full-page screenshots are stored only in the extension’s storage on your device, and replaced by the next one. Favorites, recent tools, pinned tools and settings are stored in your browser.',
      '“Insert a strong password” makes the password on your device and types it into the field you right-clicked. It is not stored, copied or sent anywhere.',
      'Its only network requests are: loading GoodWebTools pages, refreshing the tool list from goodwebtools.com, and fetching the images, video or audio you choose to send or save.',
      'There are no analytics, ads or tracking in the extension. Access to other websites is optional, asked for only when a feature needs it, and can be removed at any time in Chrome’s extension settings.',
    ],
  },
  id: {
    title: 'Privasi', home: 'Beranda', crumb: 'Privasi',
    metaDesc: 'Bagaimana GoodWebTools melindungi privasi Anda: berkas tidak pernah meninggalkan browser, analitik hanya dimuat dengan persetujuan Anda, dan bagaimana iklan Google di situs ini memakai cookie.',
    h1: 'Privasi & Keterverifikasian',
    s1H: 'Tidak ada data yang meninggalkan perangkat Anda',
    s1P: 'Semua pemrosesan terjadi di browser Anda. Tidak ada berkas, gambar, atau dokumen yang pernah diunggah ke server.',
    s2H: 'Analitik & cookie',
    s2Pa: 'Kami menggunakan satu cookie analitik yang ramah privasi (Google Analytics, dengan anonimisasi IP) untuk memahami tool mana yang bermanfaat bagi pengguna. Cookie ini ',
    s2Strong: 'hanya dimuat setelah Anda mengeklik “Terima”',
    s2Pb: ' pada banner cookie — jika menolak, tidak ada cookie analitik yang dipasang. Ini tidak pernah menyertakan berkas Anda atau isinya; dokumen Anda selalu diproses sepenuhnya di perangkat Anda.',
    s2P2: 'Anda dapat berubah pikiran kapan saja dengan menghapus data situs ini di pengaturan browser, yang akan mengatur ulang banner.',
    adsH: 'Iklan',
    adsP: [
      'GoodWebTools gratis dan didanai oleh iklan dari Google AdSense. Iklan hanya tampil di situs web — tidak pernah di dalam berkas Anda, dan tidak pernah di ekstensi browser atau di hasil sebuah tool.',
      'Vendor pihak ketiga, termasuk Google, menggunakan cookie untuk menampilkan iklan berdasarkan kunjungan Anda sebelumnya ke situs ini dan situs lain. Cookie iklan Google memungkinkan Google dan mitranya menampilkan iklan kepada Anda berdasarkan kunjungan tersebut.',
      'Di Wilayah Ekonomi Eropa, Inggris, dan Swiss, Anda dimintai persetujuan sebelum iklan yang dipersonalisasi atau cookie iklan digunakan. Jika Anda menolak, Google masih dapat menampilkan iklan non-personal, yang memakai cookie hanya untuk hal seperti pembatasan frekuensi dan pencegahan penipuan.',
      'Kami juga memakai pengukuran Google Ads untuk melihat berapa banyak pengunjung yang datang dari iklan kami sendiri.',
      'Skrip iklan tidak pernah menerima berkas, teks, atau hasil tool Anda — semuanya diproses di perangkat Anda dan tidak dikirim ke mana pun.',
    ],
    adsOptOut: 'Matikan iklan yang dipersonalisasi di',
    adsOptOutGoogle: 'Pusat Iklan Saya dari Google',
    adsOptOutOr: ', atau matikan iklan yang dipersonalisasi dari vendor lain di',
    adsHow: 'Pelajari',
    adsHowLink: 'bagaimana Google menggunakan informasi dari situs yang memakai layanannya',
    s3H: 'Verifikasi sendiri',
    s3: ['Buka Developer Tools (F12)', 'Buka tab Network', 'Gunakan tool apa pun dan proses sebuah berkas', 'Perhatikan: berkas Anda tidak pernah dikirim — satu-satunya permintaan eksternal adalah iklan dan analitik halaman, yang tidak pernah berisi berkas tersebut'],
    s4H: 'Bekerja offline',
    s4P: 'Setelah pemakaian pertama, tool bekerja dengan jaringan Anda dimatikan sepenuhnya. Ini adalah bukti terkuat bahwa tidak ada yang meninggalkan perangkat Anda.',
    s5H: 'Sumber terbuka',
    s5Pa: 'Kode bersifat sumber terbuka di GitHub — Anda dapat mengauditnya sendiri atau menjalankannya secara lokal: ',
    s6H: 'Ekstensi browser (GoodWebTools Companion)',
    s6P: 'Ekstensi Chrome opsional ini mengikuti aturan yang sama: data Anda tetap di perangkat Anda.',
    s6: [
      'Ekstensi hanya bekerja saat Anda memakainya — aksi klik kanan, tombol popup, panel samping, rekaman, atau pintasan keyboard. Ekstensi tidak membaca halaman di latar belakang dan tidak mengumpulkan riwayat penjelajahan Anda.',
      'Gambar, teks, atau URL yang Anda kirim ke tool berpindah dari ekstensi langsung ke tab GoodWebTools yang dibuka, di dalam browser Anda. Data disimpan paling lama 5 menit dan hanya dipakai sekali.',
      'Rekaman dan tangkapan layar satu halaman penuh hanya disimpan di penyimpanan ekstensi di perangkat Anda, dan diganti oleh yang berikutnya. Favorit, tool terakhir, tool yang disematkan, dan pengaturan disimpan di browser Anda.',
      '“Sisipkan kata sandi kuat” membuat kata sandi di perangkat Anda dan mengetikkannya ke kolom yang Anda klik kanan. Kata sandi itu tidak disimpan, disalin, atau dikirim ke mana pun.',
      'Permintaan jaringannya hanya: memuat halaman GoodWebTools, memperbarui daftar tool dari goodwebtools.com, dan mengambil gambar, video, atau audio yang Anda pilih untuk dikirim atau disimpan.',
      'Tidak ada analitik, iklan, atau pelacakan di ekstensi ini. Akses ke situs lain bersifat opsional, hanya diminta saat sebuah fitur membutuhkannya, dan bisa dicabut kapan saja di pengaturan ekstensi Chrome.',
    ],
  },
}[lang];
---

<Base title={P.title} description={P.metaDesc} lang={lang} localized>
  <main class="page-container max-w-3xl py-8">
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex items-center gap-1 text-sm font-bold uppercase tracking-wide text-muted-foreground">
        <li>
          <a href={homePath} class="border-2 border-border bg-muted px-2 py-1 text-foreground shadow-brutal-sm press-brutal">{P.home}</a>
        </li>
        <li aria-hidden="true"><ChevronRight className="h-3.5 w-3.5" /></li>
        <li aria-current="page" class="text-foreground">{P.crumb}</li>
      </ol>
    </nav>

    <h1 class="mb-6 text-4xl font-bold">{P.h1}</h1>

    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-semibold">{P.s1H}</h2>
      <p class="text-muted-foreground">{P.s1P}</p>
    </section>

    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-semibold">{P.s2H}</h2>
      <p class="mb-4 text-muted-foreground">{P.s2Pa}<strong>{P.s2Strong}</strong>{P.s2Pb}</p>
      <p class="text-muted-foreground">{P.s2P2}</p>
    </section>

    <section id="ads" class="mb-8 scroll-mt-24">
      <h2 class="mb-4 text-2xl font-semibold">{P.adsH}</h2>
      {P.adsP.map(para => <p class="mb-4 text-muted-foreground">{para}</p>)}
      <p class="mb-4 text-muted-foreground">
        {P.adsOptOut}{' '}
        <a href="https://myadcenter.google.com/" target="_blank" rel="noopener noreferrer" class="font-bold underline decoration-2 underline-offset-2">{P.adsOptOutGoogle}</a>{P.adsOptOutOr}{' '}
        <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer" class="font-bold underline decoration-2 underline-offset-2">aboutads.info</a>.
      </p>
      <p class="text-muted-foreground">
        {P.adsHow}{' '}
        <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer" class="font-bold underline decoration-2 underline-offset-2">{P.adsHowLink}</a>.
      </p>
    </section>

    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-semibold">{P.s3H}</h2>
      <ol class="list-inside list-decimal space-y-2 text-muted-foreground">
        {P.s3.map(step => <li>{step}</li>)}
      </ol>
    </section>

    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-semibold">{P.s4H}</h2>
      <p class="text-muted-foreground">{P.s4P}</p>
    </section>

    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-semibold">{P.s5H}</h2>
      <p class="text-muted-foreground">
        {P.s5Pa}
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="font-bold underline decoration-2 underline-offset-2">slaveofcode/goodwebtools</a>.
      </p>
    </section>

    <section id="extension" class="scroll-mt-24">
      <h2 class="mb-4 text-2xl font-semibold">{P.s6H}</h2>
      <p class="mb-4 text-muted-foreground">{P.s6P}</p>
      <ul class="list-inside list-disc space-y-2 text-muted-foreground">
        {P.s6.map(item => <li>{item}</li>)}
      </ul>
    </section>
  </main>
</Base>
