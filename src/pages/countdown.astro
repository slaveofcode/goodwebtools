<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Countdown</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    html, body {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f0f0f0;
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
      overflow: hidden;
    }

    /* Ensure screenshot fills and centers */
    body {
      position: relative;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-size: cover;
      background-position: center center;
      z-index: -1;
    }
    #countdown {
      font-size: 240px;
      font-weight: 900;
      color: white;
      text-shadow:
        0 0 40px rgba(0, 0, 0, 0.8),
        0 0 80px rgba(0, 0, 0, 0.6),
        0 4px 20px rgba(0, 0, 0, 0.9);
      font-family: system-ui, -apple-system, sans-serif;
      transition: transform 0.1s ease-out, opacity 0.1s ease-out;
      user-select: none;
    }
  </style>
</head>
<body>
  <div id="countdown">5</div>

  <script type="module">
    // Countdown from 5 to 1, then close
    let count = 5;
    const countdownEl = document.getElementById('countdown');

    // Listen for screenshot background (async, don't block countdown)
    (async () => {
      try {
        const { listen } = await import('@tauri-apps/api/event');
        console.log('[Countdown] Setting up screenshot listener');

        await listen('countdown-screenshot', (event) => {
          console.log('[Countdown] Received screenshot event');
          const { dataUrl } = event.payload;
          document.body.style.backgroundImage = `url("${dataUrl}")`;
          console.log('[Countdown] Background image set');
        });

        console.log('[Countdown] Listener registered');
      } catch (err) {
        console.error('[Countdown] Event listener failed:', err);
      }
    })();

    const interval = setInterval(() => {
      count--;
      if (count > 0) {
        countdownEl.textContent = count.toString();
        // Pulse animation
        countdownEl.style.transform = 'scale(1.15)';
        countdownEl.style.opacity = '0.7';
        setTimeout(() => {
          countdownEl.style.transform = 'scale(1)';
          countdownEl.style.opacity = '1';
        }, 150);
      } else {
        clearInterval(interval);
        // Fade out and close
        countdownEl.style.opacity = '0';
        setTimeout(() => {
          if (window.__TAURI__) {
            window.__TAURI__.core.invoke('close_countdown');
          }
        }, 200);
      }
    }, 1000);
  </script>
</body>
</html>
