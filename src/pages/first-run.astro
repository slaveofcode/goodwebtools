---
import FirstRunWizard from '@/islands/FirstRunWizard';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <!-- Desktop-app screen, not a web page: keep it out of search results. -->
    <meta name="robots" content="noindex, nofollow">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome — GoodWebTools</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { height: 100%; }
      body { background: #111827; }
    </style>
  </head>
  <body>
    <FirstRunWizard client:load />
  </body>
</html>
