---
import Base from '@/layouts/Base.astro';
import { ToolGrid } from '@/components/ToolGrid';
import { tools } from '@/registry/tools';
---

<Base title="Home">
  <main class="container mx-auto max-w-5xl px-4 py-10">
    <header class="mb-10">
      <h1 class="mb-2 text-4xl font-bold">GoodWebTools</h1>
      <p class="text-lg text-muted-foreground">
        Privacy-first client-side utilities. {tools.length} tools — everything runs in your browser.
      </p>
      <p class="mt-3 text-sm text-muted-foreground">
        Press <kbd class="rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-xs">⌘K</kbd>
        to search tools.
      </p>
    </header>

    <ToolGrid />
  </main>
</Base>
