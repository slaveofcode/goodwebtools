---
import Base from '@/layouts/Base.astro';
import { ToolGrid } from '@/components/ToolGrid';
import { tools } from '@/registry/tools';
---

<Base title="Home">
  <main class="container mx-auto max-w-5xl px-4 py-10">
    <header class="mb-10">
      <div class="inline-block border-2 border-border bg-accent px-4 py-2 text-accent-foreground shadow-brutal">
        <h1 class="text-4xl font-bold uppercase tracking-tight">GoodWebTools</h1>
      </div>
      <p class="mt-5 max-w-2xl text-lg font-medium text-foreground">
        Privacy-first client-side utilities. {tools.length} tools — everything runs in your browser.
      </p>
      <p class="mt-3 text-sm font-bold uppercase tracking-wide text-muted-foreground">
        Press
        <kbd class="mx-0.5 border-2 border-border bg-muted px-1.5 py-0.5 font-mono text-xs shadow-brutal-sm">⌘K</kbd>
        to search tools.
      </p>
    </header>

    <ToolGrid />
  </main>
</Base>
