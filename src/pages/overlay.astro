---
// Region Selector Overlay - Transparent fullscreen marquee selection
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Select Region</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        cursor: crosshair;
        background: transparent;
      }

      #overlay {
        width: 100vw;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background: #f0f0f0;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }

      #selection {
        position: absolute;
        border: 4px solid #3b82f6;
        background: rgba(59, 130, 246, 0.2);
        box-shadow:
          0 0 0 3px rgba(255, 255, 255, 0.95),
          0 0 0 7px rgba(59, 130, 246, 0.6),
          0 0 30px rgba(59, 130, 246, 0.8),
          inset 0 0 80px rgba(59, 130, 246, 0.1);
        display: none;
        pointer-events: none;
      }

      #dimensions {
        position: absolute;
        top: -32px;
        left: 0;
        background: #3b82f6;
        color: white;
        padding: 6px 12px;
        border-radius: 6px;
        font-family: monospace;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        pointer-events: none;
        box-shadow:
          0 0 0 2px rgba(255, 255, 255, 0.9),
          0 4px 12px rgba(0, 0, 0, 0.3);
      }

      #instructions {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.9);
        color: white;
        padding: 16px 32px;
        border-radius: 12px;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 16px;
        font-weight: 500;
        z-index: 1000;
        box-shadow:
          0 0 0 2px rgba(255, 255, 255, 0.2),
          0 8px 24px rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(10px);
      }
    </style>
  </head>
  <body>
    <div id="instructions">Click and drag to select a region · ESC to cancel</div>
    <div id="overlay">
      <div id="selection">
        <div id="dimensions"></div>
      </div>
    </div>

    <script>
      import { invoke } from '@tauri-apps/api/core';

      const overlay = document.getElementById('overlay')!;
      const selection = document.getElementById('selection')!;
      const dimensions = document.getElementById('dimensions')!;

      // Load screenshot from localStorage (more reliable than events)
      const screenshotData = localStorage.getItem('overlay-screenshot');
      if (screenshotData) {
        console.log('[Overlay] Loading screenshot from localStorage');
        overlay.style.backgroundImage = `url("${screenshotData}")`;
        overlay.style.backgroundSize = '100% 100%'; // Exact size, no scaling
        overlay.style.backgroundPosition = '0 0';
        console.log('[Overlay] Screenshot background applied');
      } else {
        console.log('[Overlay] No screenshot in localStorage');
      }

      let isSelecting = false;
      let startX = 0;
      let startY = 0;

      overlay.addEventListener('mousedown', (e) => {
        isSelecting = true;
        startX = e.clientX;
        startY = e.clientY;

        selection.style.left = `${startX}px`;
        selection.style.top = `${startY}px`;
        selection.style.width = '0px';
        selection.style.height = '0px';
        selection.style.display = 'block';
      });

      overlay.addEventListener('mousemove', (e) => {
        if (!isSelecting) return;

        const currentX = e.clientX;
        const currentY = e.clientY;

        const width = Math.abs(currentX - startX);
        const height = Math.abs(currentY - startY);
        const left = Math.min(startX, currentX);
        const top = Math.min(startY, currentY);

        selection.style.left = `${left}px`;
        selection.style.top = `${top}px`;
        selection.style.width = `${width}px`;
        selection.style.height = `${height}px`;

        dimensions.textContent = `${width} × ${height}`;
      });

      overlay.addEventListener('mouseup', async (e) => {
        if (!isSelecting) return;

        isSelecting = false;

        const currentX = e.clientX;
        const currentY = e.clientY;

        const width = Math.abs(currentX - startX);
        const height = Math.abs(currentY - startY);
        const left = Math.min(startX, currentX);
        const top = Math.min(startY, currentY);

        // Only submit if selection is large enough (minimum 10x10)
        if (width > 10 && height > 10) {
          const bounds = {
            x: Math.round(left),
            y: Math.round(top),
            width: Math.round(width),
            height: Math.round(height),
          };

          try {
            // Clean up screenshot from localStorage before closing
            localStorage.removeItem('overlay-screenshot');
            await invoke('submit_region_selection', { bounds });
            // Restore main window
            await invoke('show_main_window');
          } catch (error) {
            console.error('Failed to submit region:', error);
            localStorage.removeItem('overlay-screenshot');
            await invoke('show_main_window');
            await invoke('close_region_selector');
          }
        } else {
          // Selection too small, reset
          selection.style.display = 'none';
        }
      });

      // ESC to cancel
      document.addEventListener('keydown', async (e) => {
        if (e.key === 'Escape') {
          // Clean up screenshot from localStorage
          localStorage.removeItem('overlay-screenshot');
          // Restore main window
          await invoke('show_main_window');
          await invoke('close_region_selector');
        }
      });

      // Prevent context menu
      document.addEventListener('contextmenu', (e) => e.preventDefault());
    </script>
  </body>
</html>
